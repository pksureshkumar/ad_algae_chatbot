# Everything runs locally through Ollama — no cloud API keys, no billing.
#
# Make sure Ollama is running and the models are pulled:
#   ollama pull qwen3:14b       # LLM (entity extraction + answering)
#   ollama pull qwen2.5vl:32b   # vision (tables/figures during ingestion)
#   ollama pull bge-m3          # embeddings

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_LLM_MODEL=qwen3:14b
OLLAMA_VISION_MODEL=qwen2.5vl:32b
OLLAMA_EMBEDDING_MODEL=bge-m3

# Must match the embedding model's native dimension.
#   bge-m3 = 1024 | nomic-embed-text = 768 | qwen3-embedding:0.6b = 1024
# Changing this requires a full re-ingest (python ingest.py --reset).
OLLAMA_EMBEDDING_DIM=1024
OLLAMA_EMBEDDING_MAX_TOKENS=8192
OLLAMA_EMBEDDING_BATCH_SIZE=16
